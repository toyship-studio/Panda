# PandaRuntimeConfig.cmake
# Provides PandaSDK::PandaRuntime for exported games.

get_filename_component(_PANDA_SDK_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(_PANDA_SDK_INCLUDE_DIR "${_PANDA_SDK_PREFIX}/include")

if(APPLE AND IOS)
    if(CMAKE_OSX_SYSROOT MATCHES "iphonesimulator")
        set(_PANDA_SDK_PLATFORM_LIB_DIR "${_PANDA_SDK_PREFIX}/lib/ios-simulator")
    else()
        set(_PANDA_SDK_PLATFORM_LIB_DIR "${_PANDA_SDK_PREFIX}/lib/ios-device")
    endif()
    set(_PANDA_SDK_SHADER_BACKEND "opengles")
elseif(APPLE)
    set(_PANDA_SDK_PLATFORM_LIB_DIR "${_PANDA_SDK_PREFIX}/lib/macos")
    set(_PANDA_SDK_SHADER_BACKEND "opengl")
elseif(ANDROID)
    set(_PANDA_SDK_PLATFORM_LIB_DIR "${_PANDA_SDK_PREFIX}/lib/android")
    set(_PANDA_SDK_SHADER_BACKEND "opengles")
elseif(WIN32)
    set(_PANDA_SDK_PLATFORM_LIB_DIR "${_PANDA_SDK_PREFIX}/lib/windows")
    # Platform default of PANDA_SHADER_BACKEND; the actual value is in the stamp below.
    set(_PANDA_SDK_SHADER_BACKEND "d3d11")
elseif(UNIX)
    set(_PANDA_SDK_PLATFORM_LIB_DIR "${_PANDA_SDK_PREFIX}/lib/linux")
    set(_PANDA_SDK_SHADER_BACKEND "opengl")
else()
    message(FATAL_ERROR "Unsupported PandaSDK target platform")
endif()

# The actual backend recorded when the SDK was packaged. Overrides the platform
# default: the game is linked with the same defines and shaders the libraries
# are built for (for example, a Windows SDK built for OpenGL).
include("${_PANDA_SDK_PLATFORM_LIB_DIR}/PandaSDKBackend.cmake" OPTIONAL)

set(PandaSDK_ENGINE_COMMON_RESOURCES_DIR "${_PANDA_SDK_PREFIX}/resources/common")
set(PandaSDK_ENGINE_SHADER_RESOURCES_DIR "${_PANDA_SDK_PREFIX}/resources/shaders/${_PANDA_SDK_SHADER_BACKEND}")

function(_panda_sdk_add_static_library TARGET_NAME LIB_NAME)
    if(TARGET ${TARGET_NAME})
        return()
    endif()

    set(_library_path "${_PANDA_SDK_PLATFORM_LIB_DIR}/@CMAKE_STATIC_LIBRARY_PREFIX@${LIB_NAME}@CMAKE_STATIC_LIBRARY_SUFFIX@")
    if(NOT EXISTS "${_library_path}")
        message(FATAL_ERROR "PandaSDK library not found for this platform: ${_library_path}. Build PandaRuntime for the target platform first.")
    endif()

    add_library(${TARGET_NAME} STATIC IMPORTED)
    set_target_properties(${TARGET_NAME} PROPERTIES
        IMPORTED_LOCATION "${_library_path}"
        INTERFACE_INCLUDE_DIRECTORIES "${_PANDA_SDK_INCLUDE_DIR}"
    )
endfunction()

_panda_sdk_add_static_library(PandaSDK::PandaRuntime PandaRuntime)
_panda_sdk_add_static_library(PandaSDK::Panda Panda)
_panda_sdk_add_static_library(PandaSDK::Fern Fern)
_panda_sdk_add_static_library(PandaSDK::Miren Miren)
_panda_sdk_add_static_library(PandaSDK::Rain Rain)
_panda_sdk_add_static_library(PandaSDK::Foundation Foundation)
_panda_sdk_add_static_library(PandaSDK::PandaAsync PandaAsync)
_panda_sdk_add_static_library(PandaSDK::PandaUI PandaUI)
_panda_sdk_add_static_library(PandaSDK::PandaSDK PandaSDK)
_panda_sdk_add_static_library(PandaSDK::box2d box2d)
_panda_sdk_add_static_library(PandaSDK::box3d box3d)
_panda_sdk_add_static_library(PandaSDK::cgltf cgltf)
_panda_sdk_add_static_library(PandaSDK::glad glad)
_panda_sdk_add_static_library(PandaSDK::stb_image stb_image)
_panda_sdk_add_static_library(PandaSDK::yogacore yogacore)
_panda_sdk_add_static_library(PandaSDK::yaml-cpp yaml-cpp)

if(UNIX AND NOT APPLE AND NOT ANDROID)
    _panda_sdk_add_static_library(PandaSDK::glfw glfw)
endif()

set(_PANDA_RUNTIME_LINK_LIBRARIES
    PandaSDK::Panda
    PandaSDK::PandaSDK
    PandaSDK::PandaUI
    PandaSDK::Miren
    PandaSDK::Fern
    PandaSDK::Foundation
    PandaSDK::PandaAsync
    PandaSDK::Rain
    PandaSDK::yaml-cpp
    PandaSDK::box2d
    PandaSDK::box3d
    PandaSDK::cgltf
    PandaSDK::glad
    PandaSDK::stb_image
    PandaSDK::yogacore
)

set_property(TARGET PandaSDK::PandaUI APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES PandaSDK::yogacore
)

set_property(TARGET PandaSDK::PandaSDK APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES PandaSDK::PandaUI PandaSDK::PandaAsync
)

if(UNIX AND NOT APPLE AND NOT ANDROID)
    list(APPEND _PANDA_RUNTIME_LINK_LIBRARIES PandaSDK::glfw)
endif()

set_property(TARGET PandaSDK::PandaRuntime APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES ${_PANDA_RUNTIME_LINK_LIBRARIES}
)

if(WIN32)
    # d3d11+dxgi — the Fern context, d3dcompiler+dxguid — the Miren D3D11 renderer, winhttp — the
    # network layer of Fern. Always linked: system libs, no harm to a GL build.
    set_property(TARGET PandaSDK::PandaRuntime APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES opengl32 gdi32 user32 shell32 d3d11 dxgi d3dcompiler dxguid winhttp
    )
    if(_PANDA_SDK_SHADER_BACKEND STREQUAL "d3d11")
        # The libs are built with this define (Foundation::ACTIVE_GRAPHICS_API = D3D11) —
        # the game's TUs must see the same active API.
        set_property(TARGET PandaSDK::PandaRuntime APPEND PROPERTY
            INTERFACE_COMPILE_DEFINITIONS PANDA_GRAPHICS_D3D11
        )
    endif()
elseif(APPLE)
    # Metal is always linked: a system framework, no harm to a GL build
    # (the Miren/Fern Metal backend is compiled into the libs in both configurations).
    if(IOS)
        set_property(TARGET PandaSDK::PandaRuntime APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES
                "-framework UIKit"
                "-framework OpenGLES"
                "-framework Metal"
                "-framework MetalKit"
                "-framework QuartzCore"
                "-framework Foundation"
                "-framework CFNetwork"
                "-framework SystemConfiguration"
                "-framework CoreFoundation"
        )
    else()
        set_property(TARGET PandaSDK::PandaRuntime APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES
                "-framework Cocoa"
                "-framework IOKit"
                "-framework CoreFoundation"
                "-framework OpenGL"
                "-framework Metal"
                "-framework QuartzCore"
        )
    endif()
    if(_PANDA_SDK_SHADER_BACKEND STREQUAL "metal")
        # The libs are built with this define (Foundation::ACTIVE_GRAPHICS_API = Metal) —
        # the game's TUs must see the same active API.
        set_property(TARGET PandaSDK::PandaRuntime APPEND PROPERTY
            INTERFACE_COMPILE_DEFINITIONS PANDA_GRAPHICS_METAL
        )
    endif()
elseif(UNIX)
    # curl — the network layer of Fern (the libcurl of the system, context/networking.md).
    set_property(TARGET PandaSDK::PandaRuntime APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES GL X11 Xi Xcursor Xinerama Xrandr curl dl pthread m
    )
endif()

set_property(TARGET PandaSDK::PandaRuntime APPEND PROPERTY
    INTERFACE_COMPILE_DEFINITIONS GL_SILENCE_DEPRECATION
)

set_property(TARGET PandaSDK::PandaRuntime PROPERTY
    INTERFACE_COMPILE_FEATURES cxx_std_20
)
