# Modules are the folders of Modules/ with a module.json (context/plugins.md). This file finds
# them, gives each an option and orders them by the dependencies of their manifests, so a new
# module is a folder in Modules/, not an edit of the root CMakeLists.txt.
#
#   panda_scan_modules(<out-var> <modules-dir>)
#
# fills <out-var> with the folder names of the enabled modules, dependencies first. Every folder
# with a module.json and a CMakeLists.txt gets option(PANDA_MODULE_<FOLDER> ... ON); PANDA_MODULES
# (ON) switches all of them off at once, which is what the no-modules job of CI uses. A module
# switched off while a module that depends on it stays on stops the configure and names the two
# options to change.

option(PANDA_MODULES "Build the modules found in Modules/ (each has its own PANDA_MODULE_<FOLDER> option as well)" ON)

function(panda_scan_modules OUT_VAR MODULES_DIRECTORY)
    file(GLOB _entries LIST_DIRECTORIES true CONFIGURE_DEPENDS "${MODULES_DIRECTORY}/*")
    list(SORT _entries)
    set(_names "")
    foreach (_entry IN LISTS _entries)
        if (NOT IS_DIRECTORY "${_entry}")
            continue()
        endif ()
        get_filename_component(_name "${_entry}" NAME)
        if (NOT EXISTS "${_entry}/module.json")
            message(STATUS "Modules/${_name}: no module.json, not a module")
            continue()
        endif ()
        if (NOT EXISTS "${_entry}/CMakeLists.txt")
            message(WARNING "Modules/${_name} has a module.json but no CMakeLists.txt; skipped")
            continue()
        endif ()
        file(READ "${_entry}/module.json" _manifest)
        string(JSON _id ERROR_VARIABLE _error GET "${_manifest}" id)
        if (_error)
            message(FATAL_ERROR "Modules/${_name}/module.json has no id: ${_error}")
        endif ()
        set(_dependencies "")
        string(JSON _count ERROR_VARIABLE _error LENGTH "${_manifest}" dependencies)
        if (NOT _error AND _count GREATER 0)
            math(EXPR _last "${_count} - 1")
            foreach (_index RANGE 0 ${_last})
                string(JSON _dependency GET "${_manifest}" dependencies ${_index} id)
                list(APPEND _dependencies "${_dependency}")
            endforeach ()
        endif ()
        string(TOUPPER "${_name}" _upper)
        string(MAKE_C_IDENTIFIER "${_upper}" _upper)
        option(PANDA_MODULE_${_upper} "Build the ${_name} module (${_id})" ON)
        string(MAKE_C_IDENTIFIER "${_id}" _key)
        list(APPEND _names "${_name}")
        set(_module_${_name}_option "PANDA_MODULE_${_upper}")
        set(_module_${_name}_dependencies "${_dependencies}")
        set(_module_by_id_${_key} "${_name}")
    endforeach ()

    # The enabled set: the master switch and the option of the module.
    set(_enabled "")
    set(_disabled "")
    foreach (_name IN LISTS _names)
        set(_option "${_module_${_name}_option}")
        if (PANDA_MODULES AND ${_option})
            list(APPEND _enabled "${_name}")
        else ()
            list(APPEND _disabled "${_name}")
        endif ()
    endforeach ()

    # Dependencies first. A dependency that is unknown or switched off stops the configure.
    set(_ordered "")
    set(_remaining "${_enabled}")
    while (_remaining)
        set(_progress FALSE)
        foreach (_name IN LISTS _remaining)
            set(_ready TRUE)
            foreach (_dependency IN LISTS _module_${_name}_dependencies)
                string(MAKE_C_IDENTIFIER "${_dependency}" _key)
                set(_dependency_name "${_module_by_id_${_key}}")
                if (NOT _dependency_name)
                    message(FATAL_ERROR "The ${_name} module depends on ${_dependency}, which is not in ${MODULES_DIRECTORY}")
                endif ()
                if (NOT "${_dependency_name}" IN_LIST _enabled)
                    message(FATAL_ERROR "The ${_name} module depends on the ${_dependency_name} module: set ${_module_${_dependency_name}_option}=ON or ${_module_${_name}_option}=OFF")
                endif ()
                if (NOT "${_dependency_name}" IN_LIST _ordered)
                    set(_ready FALSE)
                endif ()
            endforeach ()
            if (_ready)
                list(APPEND _ordered "${_name}")
                list(REMOVE_ITEM _remaining "${_name}")
                set(_progress TRUE)
            endif ()
        endforeach ()
        if (NOT _progress)
            message(FATAL_ERROR "The modules depend on each other in a circle: ${_remaining}")
        endif ()
    endwhile ()

    if (_ordered)
        string(REPLACE ";" ", " _list "${_ordered}")
        message(STATUS "Modules: ${_list}")
    else ()
        message(STATUS "Modules: none")
    endif ()
    if (_disabled)
        string(REPLACE ";" ", " _list "${_disabled}")
        message(STATUS "Modules switched off: ${_list}")
    endif ()
    set(${OUT_VAR} "${_ordered}" PARENT_SCOPE)
endfunction()
